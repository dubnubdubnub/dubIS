{
  "manifest_version": 3,
  "name": "dubIS bridge",
  "version": "0.3.0",
  "description": "Pushes your JLCPCB or DigiKey session to a local dubIS server when you ask it to. Push-only: no web page can talk to it.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "key": "",
  "permissions": [
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "*://*.jlcpcb.com/*",
    "*://*.digikey.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "dubIS bridge",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_page": "options.html"
}

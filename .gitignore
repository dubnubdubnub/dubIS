__pycache__/
*.pyc
*.pyo
.env
data/*.csv
data/*.json
!data/constants.json
!data/pnp_part_map.json
!data/openpnp_families.json
# No trailing slash on purpose. `node_modules/` matches a DIRECTORY only, so
# when a worktree carried `node_modules` as a *symlink* to the main checkout's
# copy (a file, not a directory) the rule stopped matching and `git add -A`
# committed the symlink — pointing at an absolute path inside one developer's
# home. Pulling that made the link self-referential and broke the checkout it
# came from. Slashless matches both shapes; same for .venv.
node_modules
# Local per-developer agent config, EXCEPT generated shared skills:
# .claude/skills/dubis-cli/ is emitted by scripts/gen-cli.py and
# staleness-checked by verify.sh, so CI needs it committed — an untracked file
# can't be compared against the spec. Written as `.claude/*` rather than
# `.claude/`, because git cannot re-include a path whose parent DIRECTORY is
# excluded; only the contents can be globbed and then negated.
.claude/*
!.claude/skills/
# settings.json carries the shared PreToolUse worktree guard (see the Branch
# Workflow section of CLAUDE.md), so it has to be committed to bind anyone but
# its author. settings.local.json stays ignored — that one IS per-developer.
!.claude/settings.json
.mcp.json
.pytest_cache/
.ruff_cache/
tests/python/.live_latencies.json
*.xlsx
data/*.png
!data/dubIS.png
!data/digikey-icon.png
data/*.ico
!data/dubIS.ico
!data/lcsc-icon.ico
data/*.db
data/*.db-shm
data/*.db-wal
data/events/*.csv
data/scans/
data/webview2/
# Runtime files the server writes on startup and removes on clean shutdown
# (see CLAUDE.md's Data row). Untracked but not ignored until now, so anyone
# who ran the app got a dirty tree and would eventually commit one.
data/.v1_port
data/.dubis_lock
data-backup-*/
data_backup
test-results/
docs/superpowers/
test-results/
.superpowers/
.server-url

# CI watcher local state (only relevant when developing locally; production state lives on m4-air)
.venv
scripts/ci_watcher/.venv/
scripts/ci_watcher/*.db

# Hypothesis example database (local counterexample cache; see docs/property-testing.md)
.hypothesis/

# Browser-extension signing keys. The jlc-bridge private key lives OUTSIDE the
# repo on purpose (see extension/jlc-bridge/README.md) — only the base64 public
# half belongs in manifest.json's "key". These patterns exist so a private key
# dropped next to the extension can never be committed by accident.
*.pem
extension/**/*.pem
extension/**/*.crx
